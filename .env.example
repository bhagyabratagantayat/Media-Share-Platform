# ==============================================================================
# ENVIRONMENT VARIABLE TEMPLATE (.env.example)
# Copy this file to .env for local development.
# NEVER commit actual credentials or secrets to Git.
# ==============================================================================

# Database Connection (PostgreSQL 16+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/media_share_platform?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/media_share_platform?schema=public"

# Application Environment & URLs
NODE_ENV="development"
APP_URL="http://localhost:3000"
PORT=3000

# Authentication & Session Secrets (Must be at least 32 characters in production)
AUTH_SECRET="your-development-auth-secret-min-32-chars-long"
SESSION_SECRET="your-development-session-secret-min-32-chars-long"
ARGON2_PEPPER=""

# Redis & BullMQ Queues (Future Phase)
REDIS_URL="redis://localhost:6379"

# S3-Compatible Object Storage (Future Phase)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="media-share-bucket"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# Content Delivery Network (Future Phase)
CDN_BASE_URL="http://localhost:3000/cdn"

# Seed Data Configurations (Optional development overrides)
SEED_ADMIN_EMAIL="admin@platform.test"
SEED_ADMIN_PASSWORD="DemoAdminPassword123!"
