# ==============================================================================
# ENVIRONMENT VARIABLE TEMPLATE (.env.example)
# Copy this file to .env for local development.
# NEVER commit actual credentials or secrets to Git.
# ==============================================================================

# Database Connection (PostgreSQL 16+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/media_share_platform?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/media_share_platform?schema=public"

# Application Environment & URLs
NODE_ENV="development"
APP_URL="http://localhost:3000"
PORT=3000

# Authentication & Session Secrets (Must be at least 32 characters in production)
AUTH_SECRET="your-development-auth-secret-min-32-chars-long"
SESSION_SECRET="your-development-session-secret-min-32-chars-long"
ARGON2_PEPPER=""

# Redis & BullMQ Queue (Phase 5)
REDIS_URL="redis://localhost:6379"

# Media Processing Workers (Phase 5)
IMAGE_WORKER_CONCURRENCY="4"
VIDEO_WORKER_CONCURRENCY="2"
MAX_VIDEO_DURATION_SECONDS="7200"
MAX_PROCESSING_TIME_SECONDS="600"
KEEP_ORIGINALS="true"
MEDIA_PROCESSING_VERSION="1"
THUMBNAIL_MAX_DIMENSION="400"
# FFMPEG_PATH="/usr/bin/ffmpeg"
# FFPROBE_PATH="/usr/bin/ffprobe"

# S3-Compatible Object Storage (Phase 4)
# Supports AWS S3, Cloudflare R2, and local MinIO
STORAGE_PROVIDER="s3"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="media-share-bucket"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
S3_UPLOAD_URL_EXPIRES_SECONDS="900"
S3_DOWNLOAD_URL_EXPIRES_SECONDS="300"

# Upload Limits & Chunking (Bytes)
MAX_IMAGE_UPLOAD_BYTES="52428800"
MAX_VIDEO_UPLOAD_BYTES="2147483648"
MULTIPART_CHUNK_SIZE_BYTES="10485760"

# Content Delivery Network & Secure Media Delivery (Phase 6)
# Supports "cloudflare", "cloudfront", "storage_direct", "mock"
CDN_PROVIDER="mock"
CDN_BASE_URL="https://media.example.com"
CDN_SIGNING_SECRET="your-cdn-hmac-signing-secret-key-32-chars-long"
MEDIA_URL_EXPIRES_SECONDS="300"
DOWNLOAD_URL_EXPIRES_SECONDS="300"
ALLOW_ORIGINAL_DOWNLOAD_DEFAULT="false"

# Social Media Team & Bulk Uploads (Phase 7)
MAX_FILES_PER_BATCH="1000"
DEFAULT_UPLOAD_CONCURRENCY="6"
BATCH_CHUNK_PREPARATION_SIZE="25"

# Biometric Privacy & Face Discovery (Phase 12)
# Master feature flag (Must be explicitly 'true' to enable face discovery)
FACE_DISCOVERY_ENABLED="false"
FACE_MODEL_NAME="MobileFaceNet-128D"
FACE_MODEL_VERSION="face-model-v1"
FACE_EMBEDDING_DIMENSION="128"
FACE_SIMILARITY_THRESHOLD="0.72"
FACE_HIGH_CONFIDENCE_THRESHOLD="0.82"
FACE_PROCESSING_CONCURRENCY="2"
FACE_RETENTION_DAYS_DEFAULT="365"
TEMP_FACE_RETENTION_MINUTES="60"

# Secure Media Downloads & Bulk Export Infrastructure (Phase 13)
EXPORT_WORKER_CONCURRENCY="2"
MAX_ACTIVE_EXPORTS_PER_USER="2"
MAX_ACTIVE_EXPORTS_PER_ORGANISATION="5"
MAX_EXPORT_SIZE_BYTES="53687091200"
MAX_EXPORT_FILE_COUNT="10000"
EXPORT_URL_TTL_SECONDS="900"
EXPORT_RETENTION_HOURS="24"
ALLOW_BULK_DOWNLOAD_DEFAULT="true"

# Seed Data Configurations (Optional development overrides)
SEED_ADMIN_EMAIL="admin@platform.test"
SEED_ADMIN_PASSWORD="DemoAdminPassword123!"


